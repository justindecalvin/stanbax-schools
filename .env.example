# Copy to .env for local dev (Vite requires the VITE_ prefix).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Optional credential overrides (defaults shown; only needed to change demo creds)
VITE_ADMIN_PASSWORD=Justin2000.
VITE_PROPRIETRESS_PASSWORD=Proprietress2025!

# ---------------------------------------------------------------------------
# On GitHub, set these same values as repo Secrets WITHOUT the VITE_ prefix —
# deploy.yml maps SUPABASE_URL / SUPABASE_ANON_KEY / ADMIN_PASSWORD /
# PROPRIETRESS_PASSWORD to the VITE_* vars at build time.
# ---------------------------------------------------------------------------
